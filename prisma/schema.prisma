generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String
  source    String   // we tag "contact" here
  createdAt DateTime @default(now())
}

model Review {
  id        Int      @id @default(autoincrement())
  name      String
  role      String
  text      String
  createdAt DateTime @default(now())
}



model ContactForm {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}
